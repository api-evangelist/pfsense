      "name": "Authentication",
      "description": {
        "content": "Obtain JWT bearer tokens.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f2ca2d16-5e58-4914-af0e-b1212f7b462f",
          "name": "Obtain a JWT bearer token",
          "request": {
            "name": "Obtain a JWT bearer token",
            "description": {
              "content": "Authenticate as a local database user to obtain a signed JWT bearer\ntoken. Tokens default to one hour of validity; renew by calling this\nendpoint again.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "jwt"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Hostname or IP of the pfSense instance.",
                  "type": "any",
                  "value": "{{pfSenseHost}}",
                  "key": "pfSenseHost"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "f2ea4f08-22d0-49ce-9c86-fbd6a8276c52",
              "name": "JWT issued.",
              "originalRequest": {
